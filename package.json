{
  "name": "my-grocery-mcp",
  "version": "0.1.0",
  "description": "Personal MCP server for Swiss grocery search and promotions (Migros, Coop, Aldi, Denner, Lidl, Farmy, Volgshop, Otto's). Forked from nicktcode/swissgroceries-mcp v0.7.4 (MIT).",
  "type": "module",
  "license": "MIT",
  "author": "Yifei Ding",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "anthropic",
    "swiss",
    "grocery",
    "migros",
    "coop",
    "aldi",
    "denner",
    "lidl",
    "shopping",
    "switzerland"
  ],
  "main": "dist/index.js",
  "bin": {
    "my-grocery-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "src/data/swiss-zips.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest --run",
    "test:watch": "vitest",
    "smoke": "RUN_LIVE=1 vitest --run tests/smoke",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "migros-api-wrapper": "^1.1.37",
    "zod": "^3.24.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
